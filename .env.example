# Luma Garden — гостевой сайт (меню + бонусная карта).
# Данные общие с The Lokmaco: тот же бакет Supabase, та же организация iiko.
# Значения берутся из проекта lokmaco-qr — никаких отдельных баз заводить не нужно.

# Supabase Storage: откуда читается menu.json и медиа. Только чтение.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lokmaco-uploads

# Подпись cookie сессии карты (любая длинная случайная строка, своя для этого сайта)
CARD_SECRET=

# iiko Card API — тот же ORGANIZATION_ID, что у The Lokmaco:
# именно это даёт общий баланс и общий номер карты.
IIKO_API_KEY=
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
IIKO_ORGANIZATION_ID=

# Google Wallet — тот же класс, что у The Lokmaco. Новый класс заводить нельзя:
# это была бы вторая, не связанная программа, и у гостей отвалились бы карты.
NEXT_PUBLIC_SITE_URL=https://lumagarden.uz
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=lokmaco_loyalty
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_LOGO_URL=
